# ==============================================================================
# Chain Sentinel - Production Environment Configuration Template
# Multi-Agent DeFi Security & Autonomous Treasury Operations Platform
# Built by WWHS? for ELECTROTHON 8.0
# ==============================================================================

# --- Autonomous AI & LLM Providers ---
# Primary Google Gemini AI API Key (used for ADK Agent reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional secondary provider / embedding models)
OPENAI_API_KEY=your_openai_api_key_here

# Qwen LLM Endpoint (optional local/hosted fallback)
QWEN_API_URL=https://ollama-qwen.zeabur.app

# --- Web3 & EVM Network Settings ---
# Primary EVM JSON-RPC URL (Ethereum Mainnet or testnet)
RPC_URL=https://ethereum.publicnode.com
ETH_RPC_URL=https://ethereum.publicnode.com

# Alchemy API Key for Real-time Mempool & Whale Transaction Streams
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Target Multi-Chain RPC Providers (Fallback URLs)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# --- Fastify Backend Server Configuration ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# --- Next.js Frontend Configuration ---
# Public REST API URL for Client Connections
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public WebSocket URL for Real-Time Event Streams
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws/feed

# --- High-Performance Caching & Queues (Optional) ---
REDIS_URL=redis://localhost:6379

# --- Agent Tokenization Platform (ATP) Settings ---
# ATP Registry Service Endpoint
ATP_ENDPOINT=https://api.atp.network/v1
ATP_API_URL=https://api.atp.network/v1
ATP_API_KEY=your_atp_api_key_here
ATP_AGENT_ID=chain-sentinel-v1
ATP_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
