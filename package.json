{
  "name": "chainsentinel-monorepo",
  "version": "1.0.0",
  "description": "Chain Sentinel - Autonomous AI Multi-Agent DeFi Security & Treasury Operations Platform",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "start:api": "pnpm --filter api start",
    "build": "pnpm exec tsx scripts/build-all.ts",
    "test": "pnpm --filter agents-core test",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter api exec tsc --noEmit && pnpm --filter agents-core exec tsc --noEmit",
    "seed": "pnpm exec tsx scripts/seed-demo-data.ts",
    "deploy:atp": "pnpm exec tsx scripts/deploy-atp.ts",
    "export:codebase": "pnpm exec tsx scripts/export-codebase.ts",
    "clean": "pnpm -r exec rm -rf node_modules dist .next"
  },
  "keywords": [
    "defi",
    "security",
    "adk-ts",
    "ai-agents",
    "atp",
    "treasury-management",
    "liquidshield",
    "whalewatch"
  ],
  "author": "WWHS?",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@iqai/adk": "^0.8.1",
    "ai": "^6.0.116",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3"
  }
}
